{
  "name": "bloomnote",
  "version": "0.0.0",
  "private": true,
  "description": "Write a note, an LLM grows someone a garden.",
  "license": "MIT",
  "engines": {
    "node": ">=22.17.0 <23"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:api": "pnpm --filter @bloomnote/api dev",
    "dev:web": "pnpm --filter @bloomnote/web dev",
    "build": "pnpm run css-vars && pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint . --max-warnings=0",
    "css-vars": "node scripts/check-css-vars.mjs",
    "knip": "knip",
    "format": "prettier --write .",
    "deploy": "pnpm run verify && pnpm run deploy:only",
    "format:check": "prettier --check .",
    "comments": "node scripts/check-comments.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "verify": "pnpm run verify:fast && pnpm --filter @bloomnote/web e2e",
    "deploy:only": "pnpm --filter @bloomnote/api run deploy",
    "css-classes": "node scripts/check-css-classes.mjs",
    "gates": "node scripts/check-gates.mjs",
    "size": "node scripts/check-size.mjs",
    "security:check": "pnpm audit --audit-level=low",
    "test:guards": "node --test scripts/*.test.mjs",
    "verify:fast": "pnpm run gates && pnpm run typecheck && pnpm run size && pnpm run lint && pnpm run format:check && pnpm run css-vars && pnpm run css-classes && pnpm run comments && pnpm run check:docs && pnpm run knip && pnpm run security:check && pnpm run test:guards && pnpm run build && pnpm run test && pnpm run bundle:report",
    "bundle:report": "node scripts/report-bundle-size.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "knip": "^6.42.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
