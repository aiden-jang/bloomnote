{
  "name": "bloomnote",
  "version": "0.0.0",
  "private": true,
  "description": "Write a note, an LLM grows someone a garden.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:api": "pnpm --filter @bloomnote/api dev",
    "dev:web": "pnpm --filter @bloomnote/web dev",
    "build": "pnpm css-vars && pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint . --ext .ts,.tsx",
    "css-vars": "node scripts/check-css-vars.mjs",
    "knip": "knip",
    "format": "prettier --write .",
    "deploy": "pnpm verify && pnpm deploy:only",
    "format:check": "prettier --check .",
    "comments": "node scripts/check-comments.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm css-vars && pnpm comments && pnpm knip && pnpm build && pnpm test && pnpm --filter @bloomnote/web e2e",
    "deploy:only": "pnpm --filter @bloomnote/api run deploy"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "knip": "^6.34.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
