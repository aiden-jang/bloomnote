# Playwright writes these on every failed run: a screenshot, an error dump, and a trace zip that
# is several megabytes. They are regenerated per run and never worth keeping, and a trace committed
# once stays in git history forever even after it is deleted.
test-results/
playwright-report/
.playwright/

# Claude Code: launch.json is committed so the repo says how to run itself; local settings are
# per-machine permission grants with absolute paths in them.
.claude/settings.local.json

# Generated review output; authored references and curated README images stay tracked.
/docs/ui-qa/
/docs/ui-review/
