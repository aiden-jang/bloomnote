{
  "name": "@bloomnote/web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-tokens.mjs && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen-icons": "node scripts/gen-icons.mjs",
    "gen-og": "node scripts/gen-og.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@aidenjang/auth-client": "^0.1.0",
    "react": "^19.2.8",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.6.2",
    "vite": "^5.0.0",
    "vitest": "^2.1.8"
  }
}
