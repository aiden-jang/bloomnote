{
  "name": "@bloomnote/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "bloomnote API on Cloudflare Workers (Hono + KV garden store, serves the SPA).",
  "scripts": {
    "dev": "wrangler dev --var AUTH_URL:http://localhost:34100",
    "deploy": "pnpm --filter @bloomnote/web build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "eval": "vitest run --config vitest.eval.config.ts"
  },
  "dependencies": {
    "@aidenjang/auth-client": "^0.1.0",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.8.24",
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
