{
  "name": "@bloomnote/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "bloomnote API on Cloudflare Workers (Hono + KV garden store, serves the SPA).",
  "scripts": {
    "dev": "wrangler dev --var AUTH_URL:http://localhost:34100",
    "deploy": "pnpm --filter @bloomnote/web build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.eval.json",
    "test": "vitest run",
    "eval": "vitest run --config vitest.eval.config.ts",
    "deploy:assets": "wrangler deploy"
  },
  "dependencies": {
    "@aidenjang/auth-client": "^0.2.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.0",
    "@cloudflare/vitest-plugin": "^1.4.3"
  }
}
